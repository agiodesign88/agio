{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node tools/verify-deployment.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "data/places.json",
      "maxDuration": 40
    }
  },
  "rewrites": [
    {
      "source": "/api/:endpoint*",
      "destination": "/api/index?endpoint=:endpoint*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*).mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
